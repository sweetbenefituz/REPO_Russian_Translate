<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SweetRussianTranslate</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.1.3</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Личные пути живут в Local.props, он в git не попадает. Образец —
       Local.props.example. Собираем ВНЕ папки plugins: BepInEx сканирует её
       рекурсивно и находит вторую копию DLL в obj. -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <RepoProfile Condition="'$(RepoProfile)' == ''">Default</RepoProfile>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\REPO\profiles\$(RepoProfile)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="CheckLocalPaths" BeforeTargets="Build">
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')"
           Text="Не найдена игра: $(GameManaged). Скопируй src\Local.props.example в src\Local.props и впиши свои пути." />
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')"
           Text="Не найден BepInEx: $(BepInExCore). Проверь RepoProfile в src\Local.props." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="Unity.Localization"><HintPath>$(GameManaged)\Unity.Localization.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(GameManaged)\UnityEngine.TextCoreFontEngineModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule"><HintPath>$(GameManaged)\UnityEngine.TextCoreTextEngineModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath></Reference>
  </ItemGroup>

</Project>
